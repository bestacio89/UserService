<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ===================== -->
    <!-- Franz Common Stack -->
    <!-- ===================== -->
    <PackageVersion Include="Franz.Common.*" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Business" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Caching" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.DependencyInjection" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.EntityFramework" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.EntityFramework.PostGres" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Errors" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Hosting" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Http" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Http.Bootstrap" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Http.Client" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Http.EntityFramework" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Mediator" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Mediator.Polly" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Mediator.OpenTelemetry" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Mapping" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Messaging.Bootstrap" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Messaging.EntityFramework" Version="2.3.1" />
    <PackageVersion Include="Franz.Common.Messaging.KafKa" Version="2.3.1" />
    <!-- ===================== -->
    <!-- ASP.NET Core and Microsoft.Extensions -->
    <!-- ===================== -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.13" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.13" />
    <!-- EF Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <!-- Roslyn tooling dependency used by EF Core Design -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <!-- ===================== -->
    <!-- Third-party -->
    <!-- ===================== -->
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageVersion Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageVersion Include="Refit" Version="16.4.0" />
    <!-- ===================== -->
    <!-- Testing -->
    <!-- ===================== -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.13.4" />
  </ItemGroup>
</Project>
